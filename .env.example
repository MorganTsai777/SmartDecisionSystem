# OpenAI API 金鑰（必填）
# 請至 https://platform.openai.com/api-keys 申請您的 API 金鑰
OPENAI_API_KEY=your_openai_api_key_here

# 使用的模型名稱（選填，預設：gpt-3.5-turbo）
# 可選值：gpt-3.5-turbo, gpt-4o, gpt-4o-mini, gpt-4-turbo 等
MODEL_NAME=gpt-3.5-turbo

# 最大回應 token 數（選填，預設：1024）
MAX_TOKENS=1024

# 回應創意程度 0.0~2.0（選填，預設：0.7）
# 0.0 = 最確定性，2.0 = 最隨機
TEMPERATURE=0.7
